{
  "name": "cloudworks",
  "private": true,
  "version": "0.1.0",
  "description": "A multi-agent AI workspace you can watch: a crew of AI agents plans, builds and ships your goals across a 3D world of sky islands.",
  "license": "MIT",
  "author": "kudaliar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xNoramiya/cloudwork.git"
  },
  "homepage": "https://github.com/0xNoramiya/cloudwork#readme",
  "bugs": {
    "url": "https://github.com/0xNoramiya/cloudwork/issues"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "llm",
    "orchestration",
    "threejs",
    "react-three-fiber",
    "byok",
    "anthropic",
    "openai"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "mock-llm": "node dev/mock-llm.mjs",
    "e2e:demo": "node dev/demo_run.mjs 0 dev/out/demo 180",
    "e2e:live-mock": "node dev/live_run.mjs 0 dev/out/live 150"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "dompurify": "^3.4.16",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "nanoid": "^6.0.1",
    "openai": "^7.25.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "@oxlint/binding-linux-x64-gnu": "^1.86.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.12"
